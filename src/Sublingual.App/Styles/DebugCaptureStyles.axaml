<Styles xmlns="https://github.com/avaloniaui"
        xmlns:suki="https://github.com/kikipoulet/SukiUI">

    <!-- ── Sidebar nav items ──────────────────────────────────────────── -->
    <Style Selector="Button.nav-item">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#8BA3C7" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.nav-item:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#0F2040" />
    </Style>
    <Style Selector="Button.nav-item:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#162840" />
    </Style>
    <Style Selector="Button.nav-item-active">
        <Setter Property="Background" Value="#132647" />
        <Setter Property="Foreground" Value="#F8FBFF" />
        <Setter Property="BorderBrush" Value="#2563EB" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ── Surface cards ─────────────────────────────────────────────── -->
    <!-- Primary card: dark navy with a subtle blue border -->
    <Style Selector="suki|GlassCard.surface-card">
        <Setter Property="Background" Value="#0F172A" />
        <Setter Property="BorderBrush" Value="#1E3A5F" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <!-- Secondary stat card: slightly lighter navy -->
    <Style Selector="suki|GlassCard.stat-card">
        <Setter Property="Background" Value="#162032" />
        <Setter Property="BorderBrush" Value="#1E3A5F" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Subdued label — readable on dark but not competing with values -->
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="#8BA3C7" />
    </Style>

    <!-- Small all-caps category label above stat values -->
    <Style Selector="TextBlock.eyebrow">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="#5E7EA8" />
        <Setter Property="LetterSpacing" Value="1" />
    </Style>

    <!-- ── Buttons ────────────────────────────────────────────────────── -->
    <Style Selector="Button.action-button">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="Button.action-button:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- Refresh — steel blue outline style -->
    <Style Selector="Button.secondary-action">
        <Setter Property="Background" Value="#162032" />
        <Setter Property="Foreground" Value="#93C5FD" />
        <Setter Property="BorderBrush" Value="#2563EB" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Start Capture — solid blue -->
    <Style Selector="Button.primary-action">
        <Setter Property="Background" Value="#2563EB" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Stop — dark neutral -->
    <Style Selector="Button.neutral-action">
        <Setter Property="Background" Value="#1E293B" />
        <Setter Property="Foreground" Value="#CBD5E1" />
        <Setter Property="BorderBrush" Value="#334155" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ── Input controls ────────────────────────────────────────────── -->
    <Style Selector="ComboBox.capture-device-picker">
        <Setter Property="MinHeight" Value="42" />
    </Style>

    <Style Selector="TextBox.log-box">
        <Setter Property="Background" Value="#080F1C" />
        <Setter Property="Foreground" Value="#CBD5E1" />
        <Setter Property="BorderBrush" Value="#1E3A5F" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
        <Setter Property="FontSize" Value="13" />
    </Style>

</Styles>
