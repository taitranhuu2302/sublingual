<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="using:Sublingual.App.ViewModels"
                 xmlns:views="using:Sublingual.App.Views"
                 xmlns:conv="using:Sublingual.App.Converters"
                 xmlns:i="https://github.com/projektanker/icons.avalonia"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:suki="https://github.com/kikipoulet/SukiUI"
                 mc:Ignorable="d"
                 d:DesignWidth="960"
                 d:DesignHeight="680"
                 x:Class="Sublingual.App.Views.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 Icon="/Assets/logo.ico"
                 Title="Sublingual"
                 Width="960"
                 Height="680"
                 MinWidth="800"
                 MinHeight="520"
                 BackgroundStyle="Gradient">

    <suki:SukiWindow.Resources>
        <conv:StringEqualsConverter x:Key="StringEquals" />
    </suki:SukiWindow.Resources>

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <!-- Root: sidebar + content area -->
    <Grid ColumnDefinitions="196,*">

        <!-- ── Sidebar ───────────────────────────────────────────── -->
        <suki:GlassCard Grid.Column="0"
                        Margin="10,12,0,12"
                        Padding="0"
                        CornerRadius="18"
                        IsAnimated="False">
            <Grid RowDefinitions="Auto,*,Auto" Margin="0,20,0,16">

                <!-- App name -->
                <StackPanel Grid.Row="0" Margin="18,0,18,24" Spacing="2">
                    <TextBlock Text="Sublingual"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#F0F4FF" />
                    <TextBlock Text="{Binding CurrentPlatform}"
                               FontSize="11"
                               Foreground="#5E7EA8" />
                </StackPanel>

                <!-- Nav items -->
                <StackPanel Grid.Row="1" Spacing="6" Margin="10,0">
                     <Button Classes="nav-item nav-item-active"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Left"
                             Command="{Binding SelectTabCommand}"
                             CommandParameter="capture"
                             IsVisible="{Binding IsCaptureTabActive}">
                        <ToolTip.Tip>Capture</ToolTip.Tip>
                        <TextBlock Text="Record" VerticalAlignment="Center" />
                     </Button>
                     <Button Classes="nav-item"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Left"
                             Command="{Binding SelectTabCommand}"
                             CommandParameter="capture"
                             IsVisible="{Binding IsSettingsTabActive}">
                        <ToolTip.Tip>Capture</ToolTip.Tip>
                        <TextBlock Text="Record" VerticalAlignment="Center" />
                    </Button>
                     <Button Classes="nav-item"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Left"
                             Command="{Binding SelectTabCommand}"
                             CommandParameter="capture"
                             IsVisible="{Binding IsSessionsTabActive}">
                        <ToolTip.Tip>Capture</ToolTip.Tip>
                        <TextBlock Text="Record" VerticalAlignment="Center" />
                     </Button>
                     <Button Classes="nav-item"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Left"
                             Command="{Binding SelectTabCommand}"
                             CommandParameter="capture"
                             IsVisible="{Binding ActiveTab, Converter={StaticResource StringEquals}, ConverterParameter=speaking}">
                        <ToolTip.Tip>Capture</ToolTip.Tip>
                        <TextBlock Text="Record" VerticalAlignment="Center" />
                     </Button>

                    <Button Classes="nav-item nav-item-active"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Command="{Binding SelectTabCommand}"
                            CommandParameter="sessions"
                            IsVisible="{Binding IsSessionsTabActive}">
                        <ToolTip.Tip>Sessions</ToolTip.Tip>
                        <TextBlock Text="Sessions" VerticalAlignment="Center" />
                    </Button>
                    <Button Classes="nav-item"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Command="{Binding SelectTabCommand}"
                            CommandParameter="sessions"
                            IsVisible="{Binding IsCaptureTabActive}">
                        <ToolTip.Tip>Sessions</ToolTip.Tip>
                        <TextBlock Text="Sessions" VerticalAlignment="Center" />
                    </Button>
                     <Button Classes="nav-item"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Left"
                             Command="{Binding SelectTabCommand}"
                             CommandParameter="sessions"
                             IsVisible="{Binding IsSettingsTabActive}">
                        <ToolTip.Tip>Sessions</ToolTip.Tip>
                        <TextBlock Text="Sessions" VerticalAlignment="Center" />
                      </Button>
                     <Button Classes="nav-item"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Left"
                             Command="{Binding SelectTabCommand}"
                             CommandParameter="sessions"
                             IsVisible="{Binding ActiveTab, Converter={StaticResource StringEquals}, ConverterParameter=speaking}">
                        <ToolTip.Tip>Sessions</ToolTip.Tip>
                        <TextBlock Text="Sessions" VerticalAlignment="Center" />
                     </Button>

                    <Button Classes="nav-item nav-item-active"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Command="{Binding SelectTabCommand}"
                            CommandParameter="settings"
                            IsVisible="{Binding IsSettingsTabActive}">
                        <ToolTip.Tip>Settings</ToolTip.Tip>
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                    </Button>
                    <Button Classes="nav-item"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Command="{Binding SelectTabCommand}"
                            CommandParameter="settings"
                            IsVisible="{Binding IsCaptureTabActive}">
                        <ToolTip.Tip>Settings</ToolTip.Tip>
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                    </Button>
                     <Button Classes="nav-item"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Left"
                             Command="{Binding SelectTabCommand}"
                             CommandParameter="settings"
                             IsVisible="{Binding IsSessionsTabActive}">
                        <ToolTip.Tip>Settings</ToolTip.Tip>
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                      </Button>
                     <Button Classes="nav-item"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Left"
                             Command="{Binding SelectTabCommand}"
                             CommandParameter="settings"
                             IsVisible="{Binding ActiveTab, Converter={StaticResource StringEquals}, ConverterParameter=speaking}">
                        <ToolTip.Tip>Settings</ToolTip.Tip>
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                     </Button>

                     <!-- Speaking Practice nav -->
                      <Button Classes="nav-item nav-item-active"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Command="{Binding SelectTabCommand}"
                              CommandParameter="speaking"
                              IsVisible="{Binding ActiveTab, Converter={StaticResource StringEquals}, ConverterParameter=speaking}">
                          <ToolTip.Tip>Speaking Practice</ToolTip.Tip>
                          <TextBlock Text="Practice" VerticalAlignment="Center" />
                      </Button>
                      <Button Classes="nav-item"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Command="{Binding SelectTabCommand}"
                              CommandParameter="speaking"
                              IsVisible="{Binding ActiveTab, Converter={StaticResource StringEquals}, ConverterParameter=capture}">
                          <ToolTip.Tip>Speaking Practice</ToolTip.Tip>
                          <TextBlock Text="Practice" VerticalAlignment="Center" />
                      </Button>
                      <Button Classes="nav-item"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Command="{Binding SelectTabCommand}"
                              CommandParameter="speaking"
                              IsVisible="{Binding ActiveTab, Converter={StaticResource StringEquals}, ConverterParameter=sessions}">
                          <ToolTip.Tip>Speaking Practice</ToolTip.Tip>
                          <TextBlock Text="Practice" VerticalAlignment="Center" />
                      </Button>
                      <Button Classes="nav-item"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Command="{Binding SelectTabCommand}"
                              CommandParameter="speaking"
                              IsVisible="{Binding ActiveTab, Converter={StaticResource StringEquals}, ConverterParameter=settings}">
                          <ToolTip.Tip>Speaking Practice</ToolTip.Tip>
                          <TextBlock Text="Practice" VerticalAlignment="Center" />
                      </Button>
                 </StackPanel>

                <!-- Status at bottom -->
                <StackPanel Grid.Row="2" Margin="18,0" Spacing="8">
                    <suki:GlassCard Height="1"
                                    Padding="0"
                                    IsAnimated="False"
                                    Background="#1E3A5F" />
                    <TextBlock Text="{Binding CaptureState}"
                               FontSize="12"
                               Foreground="#5E7EA8" />
                </StackPanel>
            </Grid>
        </suki:GlassCard>

        <!-- ── Main content ──────────────────────────────────────── -->
        <suki:BusyArea Grid.Column="1"
                       IsBusy="{Binding IsBusy}"
                       BusyText="{Binding StatusMessage}">
            <Grid>

            <!-- TAB: Speaking Practice -->
            <ContentControl
                IsVisible="{Binding ActiveTab, Converter={StaticResource StringEquals}, ConverterParameter=speaking}"
                Content="{Binding SpeakingPractice}" />
            <!-- TAB: Capture -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding ActiveTab, Converter={StaticResource StringEquals}, ConverterParameter=capture}">
                <StackPanel Margin="28,24" Spacing="16">

                    <!-- Device picker -->
                    <suki:GlassCard Classes="surface-card" Padding="20">
                        <Grid>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
                                <StackPanel Grid.Row="0" Spacing="4">
                                    <TextBlock Text="{Binding SelectedDeviceName}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#F0F4FF"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <ComboBox Grid.Row="1"
                                          Classes="capture-device-picker"
                                          ItemsSource="{Binding Devices}"
                                          SelectedItem="{Binding SelectedDevice}"
                                          DisplayMemberBinding="{Binding DisplayName}"
                                          PlaceholderText="No device available"
                                          HorizontalAlignment="Stretch" />

                                <Grid Grid.Row="2"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">
                                    <ComboBox ItemsSource="{Binding SessionFolders}"
                                              SelectedItem="{Binding SelectedSessionFolder}"
                                              DisplayMemberBinding="{Binding DisplayName}"
                                              PlaceholderText="Select an existing session folder"
                                              HorizontalAlignment="Stretch" />
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding IsGlobalSessionFolderSelected}"
                                              IsEnabled="False"
                                              VerticalAlignment="Center"
                                              Content="Global" />
                                </Grid>

                                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10">
                                    <Button Classes="action-button secondary-action"
                                            Command="{Binding RefreshDevicesCommand}"
                                            Content="Refresh" />
                                    <Button Classes="action-button primary-action"
                                            Command="{Binding StartCaptureCommand}"
                                            Content="Start Capture" />
                                    <Button Classes="action-button neutral-action"
                                            Command="{Binding StopCaptureCommand}"
                                            Content="Stop" />
                                </StackPanel>
                            </Grid>

                        </Grid>
                    </suki:GlassCard>

                    <suki:GlassCard Classes="surface-card"
                                    Padding="20">
                        <Grid ColumnDefinitions="*,110" ColumnSpacing="16">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="eyebrow" Text="Audio Level" />
                                <suki:GlassCard Height="52"
                                                CornerRadius="10"
                                                Background="#0D1F38"
                                                Padding="10,6"
                                                IsAnimated="False">
                                    <ItemsControl ItemsSource="{Binding AudioLevelBars}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="6"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AudioLevelBarViewModel">
                                                <Border Width="8"
                                                        Height="{Binding Height}"
                                                        CornerRadius="4"
                                                        Background="#60A5FA"
                                                        Opacity="{Binding Opacity}"
                                                        VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </suki:GlassCard>
                                <TextBlock Text="{Binding AudioLevelText}"
                                           FontSize="12"
                                           Foreground="#8BA3C7" />
                            </StackPanel>
                            <suki:GlassCard Grid.Column="1" Classes="stat-card" Padding="12">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Classes="eyebrow" Text="Peak" HorizontalAlignment="Center" />
                                    <suki:CircleProgressBar Width="72"
                                                            Height="72"
                                                            Value="{Binding PeakAudioLevel}" />
                                    <TextBlock Text="{Binding PeakAudioLevel, StringFormat={}{0:0}%}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#F0F4FF"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </suki:GlassCard>
                        </Grid>
                    </suki:GlassCard>

                </StackPanel>
            </ScrollViewer>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding ActiveTab, Converter={StaticResource StringEquals}, ConverterParameter=sessions}">
                <StackPanel Margin="28,24" Spacing="16">
                    <suki:GlassCard Classes="surface-card" Padding="20"
                                    IsVisible="{Binding IsSessionsListPageActive}">
                        <Grid>
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Sessions"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F0F4FF" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Classes="action-button secondary-action"
                                            Command="{Binding RefreshSavedSessionsCommand}"
                                            VerticalAlignment="Top">
                                        <ToolTip.Tip>Reload sessions</ToolTip.Tip>
                                        <i:Icon Value="fa-solid fa-rotate-right" FontSize="14" />
                                    </Button>
                                    <Button Grid.Column="3"
                                            Classes="action-button secondary-action"
                                            Command="{Binding ToggleSelectAllSessionsCommand}"
                                            VerticalAlignment="Top">
                                        <ToolTip.Tip>Select or clear current page</ToolTip.Tip>
                                        <i:Icon Value="fa-solid fa-list-check" FontSize="14" />
                                    </Button>
                                    <Button Grid.Column="4"
                                            Classes="action-button neutral-action"
                                            Command="{Binding ClearSavedSessionsCommand}"
                                            VerticalAlignment="Top">
                                        <ToolTip.Tip>Clear all sessions</ToolTip.Tip>
                                        <i:Icon Value="fa-solid fa-broom" FontSize="14" />
                                    </Button>
                                </Grid>

                                <Grid MinHeight="34">
                                    <TextBlock Text="Selected sessions ready"
                                               Foreground="#8BA3C7"
                                               VerticalAlignment="Center"
                                               Opacity="{Binding HasSelectedSessions, Converter={StaticResource StringEquals}, ConverterParameter=True}" />
                                </Grid>

                                <TextBox Watermark="Search sessions"
                                          Text="{Binding SessionSearchText}" />

                                <TextBlock Text="No saved sessions yet."
                                           Foreground="#8BA3C7"
                                           IsVisible="{Binding NoSavedSessions}" />

                                <TextBlock Text="No sessions match your search."
                                           Foreground="#8BA3C7"
                                           IsVisible="{Binding NoSearchResults}" />

                                <suki:GlassCard Padding="12"
                                                IsAnimated="False"
                                                IsVisible="{Binding IsSessionsListPageActive}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Session Folders"
                                                   Foreground="#F0F4FF"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Pick a folder to view and to use for next capture"
                                                   Foreground="#8BA3C7"
                                                   FontSize="11" />
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                              ColumnSpacing="10">
                                            <ComboBox ItemsSource="{Binding SessionFolders}"
                                                      SelectedItem="{Binding SelectedSessionFolder}"
                                                      DisplayMemberBinding="{Binding DisplayName}"
                                                      PlaceholderText="Select folder"
                                                      HorizontalAlignment="Stretch" />
                                             <Button Grid.Column="1"
                                                     Classes="action-button neutral-action"
                                                     Command="{Binding OpenCreateSessionDialogCommand}"
                                                     Content="New" />
                                             <Button Grid.Column="2"
                                                     Classes="action-button neutral-action"
                                                     Command="{Binding OpenMoveSelectedSessionsDialogCommand}"
                                                     Content="Move Selected"
                                                     IsEnabled="{Binding HasSelectedSessions}" />
                                             <Button Grid.Column="3"
                                                     Classes="action-button neutral-action"
                                                     Command="{Binding OpenRenameSessionFolderDialogCommand}"
                                                     Content="Rename" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto"
                                              ColumnSpacing="10">
                                            <Button Classes="action-button neutral-action"
                                                    Command="{Binding OpenDeleteSessionFolderDialogCommand}"
                                                    Content="Delete Folder" />
                                            <Button Grid.Column="1"
                                                    Classes="action-button neutral-action"
                                                    Command="{Binding DeleteSelectedSessionsCommand}"
                                                    Content="Delete Selected"
                                                    IsEnabled="{Binding HasSelectedSessions}" />
                                        </Grid>
                                    </StackPanel>
                                </suki:GlassCard>

                                <Grid IsVisible="{Binding HasSavedSessions}"
                                      RowDefinitions="Auto,*"
                                      RowSpacing="8">
                                    <Grid ColumnDefinitions="48,*,140,160,140"
                                          Margin="0,0,0,4">
                                        <CheckBox IsChecked="{Binding AreAllSessionsSelected}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center">
                                            <ToolTip.Tip>Select or clear current page</ToolTip.Tip>
                                         </CheckBox>
                                        <TextBlock Grid.Column="1" Text="Session" Foreground="#64748B" FontSize="12" />
                                        <TextBlock Grid.Column="2" Text="Folder" Foreground="#64748B" FontSize="12" />
                                        <TextBlock Grid.Column="3" Text="Created" Foreground="#64748B" FontSize="12" />
                                        <TextBlock Grid.Column="4" Text="Audio" Foreground="#64748B" FontSize="12" />
                                    </Grid>
                                      <ListBox Grid.Row="1"
                                               MaxHeight="320"
                                              ItemsSource="{Binding SavedSessions}"
                                              SelectedItem="{Binding SelectedSavedSession}">
                                         <ListBox.ItemTemplate>
                                              <DataTemplate x:DataType="vm:CaptureSessionItemViewModel">
                                                   <suki:GlassCard Margin="0,0,0,6"
                                                                   Padding="10">
                                                       <Grid ColumnDefinitions="48,*,140,160,140"
                                                             ColumnSpacing="12">
                                                          <CheckBox IsChecked="{Binding IsSelected}"
                                                                    VerticalAlignment="Center"
                                                                   HorizontalAlignment="Left">
                                                             <ToolTip.Tip>Select session</ToolTip.Tip>
                                                         </CheckBox>

                                                          <!-- Click on the row (excluding the checkbox) opens detail page -->
                                                          <Button Grid.Column="1"
                                                                  Grid.ColumnSpan="4"
                                                                  Background="Transparent"
                                                                  BorderBrush="Transparent"
                                                                  BorderThickness="0"
                                                                 Padding="0"
                                                                  HorizontalContentAlignment="Stretch"
                                                                  Command="{Binding $parent[Window].DataContext.OpenSessionDetailCommand}"
                                                                  CommandParameter="{Binding}">
                                                               <Grid ColumnDefinitions="*,140,160,140"
                                                                     ColumnSpacing="12">
                                                                    <StackPanel Spacing="2">
                                                                        <TextBlock Text="{Binding DisplayTitle}"
                                                                                   Foreground="#F0F4FF"
                                                                                   FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   MaxLines="1" />
                                                                        <TextBlock Text="{Binding DisplaySessionId}"
                                                                                   Foreground="#64748B"
                                                                                   FontSize="11"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   MaxLines="1" />
                                                                    </StackPanel>
                                                                   <TextBlock Grid.Column="1"
                                                                              Text="{Binding DisplayTreePath}"
                                                                              Foreground="#8BA3C7"
                                                                              TextTrimming="CharacterEllipsis"
                                                                              MaxLines="1" />
                                                                   <TextBlock Grid.Column="2"
                                                                              Text="{Binding CreatedAtText}"
                                                                              Foreground="#8BA3C7"
                                                                              TextTrimming="CharacterEllipsis"
                                                                              MaxLines="1" />
                                                                   <TextBlock Grid.Column="3"
                                                                              Text="{Binding DisplayAudioFileName}"
                                                                              Foreground="#8BA3C7"
                                                                              TextTrimming="CharacterEllipsis"
                                                                              MaxLines="1" />
                                                               </Grid>
                                                         </Button>
                                                     </Grid>
                                                 </suki:GlassCard>
                                             </DataTemplate>
                                         </ListBox.ItemTemplate>
                                     </ListBox>
                                 </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      IsVisible="{Binding HasSavedSessions}">
                                    <Button Classes="action-button neutral-action"
                                            Command="{Binding PreviousSessionsPageCommand}"
                                            Content="Prev" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SessionsPageText}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="#8BA3C7" />
                                    <Button Grid.Column="2"
                                            Classes="action-button neutral-action"
                                            Command="{Binding NextSessionsPageCommand}"
                                            Content="Next" />
                                </Grid>
                            </StackPanel>

                        </Grid>
                    </suki:GlassCard>

                    <!-- Detail page (navigated from sessions list) -->
                    <suki:GlassCard Classes="stat-card"
                                    Padding="16"
                                    IsVisible="{Binding IsSessionsDetailPageActive}">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                <Button Classes="action-button secondary-action"
                                        Command="{Binding BackToSessionsListCommand}"
                                        Content="Back"
                                        VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Session Detail"
                                               FontWeight="SemiBold"
                                               Foreground="#F0F4FF" />
                                    <TextBlock Text="{Binding SelectedSessionEntryCountText}"
                                               Foreground="#8BA3C7"
                                               FontSize="12" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Classes="action-button secondary-action"
                                        Command="{Binding OpenSelectedSessionFolderCommand}"
                                        Content="Open Folder"
                                        VerticalAlignment="Top" />
                                <Button Grid.Column="3"
                                        Classes="action-button secondary-action"
                                        Command="{Binding PlaySelectedSessionAudioCommand}"
                                        Content="Play Audio"
                                        VerticalAlignment="Top" />
                                <Button Grid.Column="4"
                                        Classes="action-button neutral-action"
                                        Command="{Binding ExportSelectedSessionTranscriptAsTxtCommand}"
                                        Content="Export TXT"
                                        VerticalAlignment="Top" />
                                <Button Grid.Column="5"
                                        Classes="action-button neutral-action"
                                        Command="{Binding DeleteCurrentSessionCommand}"
                                        Content="Delete"
                                        VerticalAlignment="Top" />
                            </Grid>

                            <Grid ColumnDefinitions="*,250" ColumnSpacing="20">
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="eyebrow" Text="Model" />
                                        <TextBlock Text="{Binding SelectedSessionModelName}"
                                                   Foreground="#F0F4FF" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Classes="eyebrow" Text="Device" />
                                        <TextBlock Text="{Binding SelectedSessionDeviceName}"
                                                   Foreground="#F0F4FF" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Classes="eyebrow" Text="Language / Duration / Tree" />
                                        <TextBlock Text="{Binding SelectedSessionLanguage}"
                                                   Foreground="#F0F4FF" />
                                        <TextBlock Text="{Binding SelectedSessionDurationText}"
                                                   Foreground="#8BA3C7"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding SelectedSessionTreePath}"
                                                   Foreground="#64748B"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <suki:GlassCard Grid.Column="1"
                                                Padding="14"
                                                Classes="stat-card"
                                                IsAnimated="False">
                                    <StackPanel Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="Session Progress"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F0F4FF" />
                                        <TextBlock Text="1. Metadata loaded for the selected session"
                                                   Foreground="#8BA3C7"
                                                   IsVisible="{Binding HasSelectedSavedSession}" />
                                        <TextBlock Text="2. Audio file ready to open or play"
                                                   Foreground="#8BA3C7"
                                                   IsVisible="{Binding HasSelectedSavedSession}" />
                                        <TextBlock Text="3. Transcript entries ready for review or export"
                                                   Foreground="#8BA3C7"
                                                   IsVisible="{Binding HasSelectedSessionTranscriptEntries}" />
                                    </StackPanel>
                                </suki:GlassCard>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="eyebrow" Text="Audio File" />
                                    <SelectableTextBlock Text="{Binding SelectedSessionAudioPath}"
                                                         Foreground="#8BA3C7"
                                                         TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="action-button neutral-action"
                                        Command="{Binding ExportSelectedSessionTranscriptAsJsonCommand}"
                                        Content="Export JSON"
                                        VerticalAlignment="Top" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="eyebrow" Text="Transcript File" />
                                <SelectableTextBlock Text="{Binding SelectedSessionTranscriptPath}"
                                                     Foreground="#64748B"
                                                     TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Text="Session Transcript"
                                       FontWeight="SemiBold"
                                       Foreground="#F0F4FF" />
                            <TextBlock Text="No transcript entries saved yet."
                                       Foreground="#8BA3C7"
                                       IsVisible="{Binding NoSelectedSessionTranscriptEntries}" />
                            <ScrollViewer MaxHeight="420"
                                          IsVisible="{Binding HasSelectedSessionTranscriptEntries}">
                                <ItemsControl ItemsSource="{Binding SelectedSessionTranscriptEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SavedTranscriptEntryViewModel">
                                            <suki:GlassCard Margin="0,0,0,10"
                                                            Padding="12">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="{Binding UpdatedAtText}"
                                                               Foreground="#64748B"
                                                               FontSize="11" />
                                                    <TextBlock Text="{Binding PartialText}"
                                                               Foreground="#60A5FA"
                                                               FontStyle="Italic"
                                                               TextWrapping="Wrap"
                                                               IsVisible="{Binding HasPartial}" />
                                                    <TextBlock Text="{Binding FinalText}"
                                                               Foreground="#F0F4FF"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               IsVisible="{Binding HasFinal}" />
                                                    <TextBlock Text="{Binding FinalTranslatedText}"
                                                               Foreground="#BAE6FD"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               IsVisible="{Binding HasFinalTranslation}" />
                                                </StackPanel>
                                            </suki:GlassCard>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </suki:GlassCard>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB: Settings -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding ActiveTab, Converter={StaticResource StringEquals}, ConverterParameter=settings}">
                <StackPanel Margin="28,24" Spacing="16">
                    <TextBlock Text="Settings"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#F0F4FF" />

                    <suki:GlassCard Background="#081221"
                                    CornerRadius="999"
                                    Padding="4">
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                            <Button Classes="action-button primary-action"
                                    IsVisible="{Binding IsGeneralSettingsTabActive}"
                                    Command="{Binding SelectSettingsTabCommand}"
                                    CommandParameter="general"
                                    Content="General" />
                            <Button Classes="action-button secondary-action"
                                    IsVisible="{Binding IsGeneralSettingsTabInactive}"
                                    Command="{Binding SelectSettingsTabCommand}"
                                    CommandParameter="general"
                                    Content="General" />
                            <Button Grid.Column="1"
                                    Classes="action-button primary-action"
                                    IsVisible="{Binding IsSpeechSettingsTabActive}"
                                    Command="{Binding SelectSettingsTabCommand}"
                                    CommandParameter="speech"
                                    Content="Speech" />
                            <Button Grid.Column="1"
                                    Classes="action-button secondary-action"
                                    IsVisible="{Binding IsSpeechSettingsTabInactive}"
                                    Command="{Binding SelectSettingsTabCommand}"
                                    CommandParameter="speech"
                                    Content="Speech" />

                            <Button Grid.Column="2"
                                    Classes="action-button primary-action"
                                    IsVisible="{Binding IsTranslationSettingsTabActive}"
                                    Command="{Binding SelectSettingsTabCommand}"
                                    CommandParameter="translation"
                                    Content="Translation" />
                            <Button Grid.Column="2"
                                    Classes="action-button secondary-action"
                                    IsVisible="{Binding IsTranslationSettingsTabInactive}"
                                    Command="{Binding SelectSettingsTabCommand}"
                                    CommandParameter="translation"
                                    Content="Translation" />

                            <Button Grid.Column="3"
                                    Classes="action-button primary-action"
                                    IsVisible="{Binding IsOverlaySettingsTabActive}"
                                    Command="{Binding SelectSettingsTabCommand}"
                                    CommandParameter="overlay"
                                    Content="Overlay" />
                            <Button Grid.Column="3"
                                    Classes="action-button secondary-action"
                                    IsVisible="{Binding IsOverlaySettingsTabInactive}"
                                    Command="{Binding SelectSettingsTabCommand}"
                                    CommandParameter="overlay"
                                    Content="Overlay" />
                        </Grid>
                    </suki:GlassCard>

                    <suki:GlassCard Classes="surface-card"
                                    Padding="20"
                                    IsVisible="{Binding IsGeneralSettingsTabActive}">
                        <StackPanel Spacing="12">
                                    <TextBlock Text="Saved Sessions Folder"
                                               FontWeight="SemiBold"
                                               Foreground="#F0F4FF" />
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10">
                                        <TextBox Text="{Binding SessionsDirectoryPath}"
                                                 Watermark="~/.sublingual/sessions"
                                                 IsReadOnly="True"
                                                 HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1"
                                                Classes="action-button secondary-action"
                                                Command="{Binding BrowseSessionsDirectoryCommand}"
                                                Content="Browse" />
                                    </Grid>
                                    <TextBlock Text="Relative paths are resolved under ~/.sublingual. Absolute paths are also supported."
                                               Foreground="#8BA3C7"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                    </suki:GlassCard>

                    <suki:GlassCard Classes="surface-card"
                                    Padding="20"
                                    IsVisible="{Binding IsSpeechSettingsTabActive}">
                        <StackPanel Spacing="12">
                                    <TextBlock Text="Managed Models Folder"
                                               FontWeight="SemiBold"
                                               Foreground="#F0F4FF" />
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10">
                                        <TextBox Text="{Binding SpeechToTextModelsDirectoryPath}"
                                                 Watermark="~/.sublingual/speech-to-text-models"
                                                 IsReadOnly="True"
                                                 HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1"
                                                Classes="action-button secondary-action"
                                                Command="{Binding BrowseSpeechToTextModelsDirectoryCommand}"
                                                Content="Browse" />
                                    </Grid>
                                     <ComboBox ItemsSource="{Binding SpeechToTextModels}"
                                               SelectedItem="{Binding SelectedSpeechToTextModel}"
                                               DisplayMemberBinding="{Binding Name}"
                                               PlaceholderText="No local model found"
                                               HorizontalAlignment="Stretch" />
                                     <Grid ColumnDefinitions="Auto,*"
                                           ColumnSpacing="12">
                                         <TextBlock Text="Realtime"
                                                    VerticalAlignment="Center"
                                                    Foreground="#8BA3C7" />
                                         <ComboBox Grid.Column="1"
                                                   SelectedItem="{Binding SelectedSpeechToTextChunkPreset}"
                                                   ItemsSource="{Binding SpeechToTextChunkPresetOptions}"
                                                   HorizontalAlignment="Stretch" />
                                     </Grid>
                                     <TextBlock Text="Fast = ~275ms/chunk, Balanced = ~350ms/chunk, Accurate = ~500ms/chunk."
                                                 Foreground="#8BA3C7"
                                                 FontSize="12"
                                                 TextWrapping="Wrap" />
                                      <Grid ColumnDefinitions="*,Auto"
                                            ColumnSpacing="10">
                                          <TextBlock Text="Install bundled default models from the app, or import your own Vosk zip and folder manually."
                                                     Foreground="#8BA3C7"
                                                     FontSize="12"
                                                     TextWrapping="Wrap"
                                                     VerticalAlignment="Center" />
                                          <Button Grid.Column="1"
                                                  Classes="action-button secondary-action"
                                                  Command="{Binding OpenInstallSpeechModelsDialogCommand}"
                                                  Content="Install Vosk Models" />
                                      </Grid>
                                       <StackPanel Orientation="Horizontal" Spacing="10">
                                          <Button Classes="action-button neutral-action"
                                                  Command="{Binding ImportSpeechToTextModelCommand}"
                                                 Content="Import Folder" />
                                        <Button Classes="action-button neutral-action"
                                                Command="{Binding ImportSpeechToTextModelZipCommand}"
                                                Content="Import Zip" />
                                        <Button Classes="action-button secondary-action"
                                                Command="{Binding OpenSpeechToTextModelsFolderCommand}"
                                                Content="Open Models Folder" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SpeechToTextStatus}"
                                               Foreground="#8BA3C7"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                    </suki:GlassCard>

                    <suki:GlassCard Classes="surface-card"
                                    Padding="20"
                                    IsVisible="{Binding IsTranslationSettingsTabActive}">
                        <StackPanel Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Translation Factory"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F0F4FF" />
                                        <TextBlock Classes="muted"
                                                   FontSize="13"
                                                   Text="Choose one provider directly or run an ordered fallback chain from settings."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                        <TextBlock Text="Factory"
                                                   VerticalAlignment="Center"
                                                   Foreground="#8BA3C7" />
                                         <ComboBox Grid.Column="1"
                                                   SelectedItem="{Binding SelectedTranslationFactory}">
                                             <x:String>FallbackChain</x:String>
                                             <x:String>TranslateServiceLocal</x:String>
                                             <x:String>GoogleTranslateFreeApi</x:String>
                                             <x:String>LibreTranslate</x:String>
                                         </ComboBox>
                                    </Grid>

                                    <suki:GlassCard Background="#0D1F38"
                                                    CornerRadius="10"
                                                    Padding="14">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Realtime Translation Languages"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F0F4FF" />
                                            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="12">
                                                <TextBlock Text="From"
                                                           VerticalAlignment="Center"
                                                           Foreground="#8BA3C7" />
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding TranslationLanguages}"
                                                          SelectedValueBinding="{Binding Code}"
                                                          SelectedValue="{Binding SelectedSourceLanguage}"
                                                          DisplayMemberBinding="{Binding Name}"
                                                          HorizontalAlignment="Stretch" />
                                                <TextBlock Grid.Column="2"
                                                           Text="To"
                                                           VerticalAlignment="Center"
                                                           Foreground="#8BA3C7" />
                                                <ComboBox Grid.Column="3"
                                                          ItemsSource="{Binding TranslationLanguages}"
                                                          SelectedValueBinding="{Binding Code}"
                                                          SelectedValue="{Binding SelectedTargetLanguage}"
                                                          DisplayMemberBinding="{Binding Name}"
                                                          HorizontalAlignment="Stretch" />
                                            </Grid>
                                            <TextBlock Text="If From and To are the same, realtime translation is skipped and only the original transcript is shown."
                                                       Foreground="#8BA3C7"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Translate Partials"
                                                               FontWeight="SemiBold"
                                                               Foreground="#F0F4FF" />
                                                    <TextBlock Text="Off by default. Keep this disabled to reduce jitter, duplicate requests, and unstable live translations."
                                                               Foreground="#8BA3C7"
                                                               FontSize="12"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1"
                                                          IsChecked="{Binding TranslatePartials}"
                                                          VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </suki:GlassCard>

                                    <suki:GlassCard Background="#0D1F38"
                                                    CornerRadius="10"
                                                    Padding="14"
                                                    IsVisible="{Binding IsFallbackTranslationFactory}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Fallback Provider Order"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F0F4FF" />
                                            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="12">
                                                <TextBlock Text="Primary"
                                                           VerticalAlignment="Center"
                                                           Foreground="#8BA3C7" />
                                                 <ComboBox Grid.Column="1"
                                                           SelectedItem="{Binding TranslationPrimaryProvider}">
                                                     <x:String>TranslateServiceLocal</x:String>
                                                     <x:String>GoogleTranslateFreeApi</x:String>
                                                     <x:String>LibreTranslate</x:String>
                                                 </ComboBox>
                                                <TextBlock Grid.Column="2"
                                                           Text="Secondary"
                                                           VerticalAlignment="Center"
                                                           Foreground="#8BA3C7" />
                                                 <ComboBox Grid.Column="3"
                                                           SelectedItem="{Binding TranslationSecondaryProvider}">
                                                     <x:String>TranslateServiceLocal</x:String>
                                                     <x:String>GoogleTranslateFreeApi</x:String>
                                                     <x:String>LibreTranslate</x:String>
                                                 </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </suki:GlassCard>

                                     <suki:GlassCard Background="#0D1F38"
                                                     CornerRadius="10"
                                                     Padding="14">
                                         <StackPanel Spacing="12">
                                             <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                 <StackPanel Spacing="2">
                                                     <TextBlock Text="TranslateServiceLocal"
                                                                FontWeight="SemiBold"
                                                                Foreground="#F0F4FF" />
                                                     <TextBlock Text="Local Marian/CTranslate2 service optimized for partial and final subtitle updates."
                                                                Foreground="#8BA3C7"
                                                                FontSize="12"
                                                                TextWrapping="Wrap" />
                                                 </StackPanel>
                                                 <CheckBox Grid.Column="1"
                                                           IsChecked="{Binding TranslateServiceLocalEnabled}"
                                                           VerticalAlignment="Center" />
                                             </Grid>
                                             <TextBlock Text="Base URL"
                                                        Foreground="#8BA3C7"
                                                        FontSize="12" />
                                             <TextBox Text="{Binding TranslateServiceLocalBaseUrl}"
                                                      Watermark="http://127.0.0.1:3333"
                                                      HorizontalAlignment="Stretch" />
                                             <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                 <StackPanel Spacing="2">
                                                     <TextBlock Text="Use Realtime Endpoint For Finals"
                                                                FontWeight="SemiBold"
                                                                Foreground="#F0F4FF" />
                                                     <TextBlock Text="Keep final translations on the realtime endpoint so draft and final session state stays coherent."
                                                                Foreground="#8BA3C7"
                                                                FontSize="12"
                                                                TextWrapping="Wrap" />
                                                 </StackPanel>
                                                 <CheckBox Grid.Column="1"
                                                           IsChecked="{Binding TranslateServiceLocalUseRealtimeEndpointForFinals}"
                                                           VerticalAlignment="Center" />
                                             </Grid>
                                         </StackPanel>
                                     </suki:GlassCard>

                                     <suki:GlassCard Background="#0D1F38"
                                                     CornerRadius="10"
                                                     Padding="14">
                                         <StackPanel Spacing="12">
                                             <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                 <StackPanel Spacing="2">
                                                     <TextBlock Text="GoogleTranslateFreeApi"
                                                               FontWeight="SemiBold"
                                                               Foreground="#F0F4FF" />
                                                    <TextBlock Text="Free Google endpoint. Useful as the first lightweight fallback."
                                                               Foreground="#8BA3C7"
                                                               FontSize="12"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1"
                                                          IsChecked="{Binding GoogleTranslateFreeApiEnabled}"
                                                          VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="Endpoint"
                                                       Foreground="#8BA3C7"
                                                       FontSize="12" />
                                            <TextBox Text="{Binding GoogleTranslateFreeApiEndpoint}"
                                                     Watermark="https://translate.googleapis.com/translate_a/single"
                                                     HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </suki:GlassCard>

                                    <suki:GlassCard Background="#0D1F38"
                                                    CornerRadius="10"
                                                    Padding="14">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="LibreTranslate"
                                                               FontWeight="SemiBold"
                                                               Foreground="#F0F4FF" />
                                                    <TextBlock Text="Configurable hosted or self-hosted LibreTranslate endpoint."
                                                               Foreground="#8BA3C7"
                                                               FontSize="12"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1"
                                                          IsChecked="{Binding LibreTranslateEnabled}"
                                                          VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="Endpoint"
                                                       Foreground="#8BA3C7"
                                                       FontSize="12" />
                                            <TextBox Text="{Binding LibreTranslateEndpoint}"
                                                     Watermark="https://libretranslate.com/translate"
                                                     HorizontalAlignment="Stretch" />
                                            <TextBlock Text="API Key"
                                                       Foreground="#8BA3C7"
                                                       FontSize="12" />
                                            <TextBox Text="{Binding LibreTranslateApiKey}"
                                                     Watermark="Optional API key"
                                                     HorizontalAlignment="Stretch" />
                                         </StackPanel>
                                     </suki:GlassCard>

                                     <suki:GlassCard Background="#0D1F38"
                                                     CornerRadius="10"
                                                     Padding="14">
                                         <StackPanel Spacing="12">
                                             <StackPanel Spacing="3">
                                                 <TextBlock Text="Speaking Practice AI"
                                                            FontWeight="SemiBold"
                                                            Foreground="#F0F4FF" />
                                                 <TextBlock Text="Used by the Practice tab rooms."
                                                            Foreground="#8BA3C7"
                                                            FontSize="12" />
                                             </StackPanel>

                                             <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                 <TextBlock Text="Provider"
                                                            VerticalAlignment="Center"
                                                            Foreground="#8BA3C7" />
                                                 <ComboBox Grid.Column="1"
                                                           SelectedItem="{Binding SpeakingPracticeAiProvider}">
                                                     <x:String>Groq</x:String>
                                                     <x:String>Gemini</x:String>
                                                 </ComboBox>
                                             </Grid>

                                             <TextBlock Text="Groq API Key"
                                                        Foreground="#8BA3C7"
                                                        FontSize="12" />
                                             <TextBox Text="{Binding SpeakingPracticeGroqApiKey}"
                                                      PasswordChar="*"
                                                      Watermark="gsk_..."
                                                      HorizontalAlignment="Stretch" />

                                             <TextBlock Text="Groq Model"
                                                        Foreground="#8BA3C7"
                                                        FontSize="12" />
                                             <TextBox Text="{Binding SpeakingPracticeGroqModel}"
                                                      Watermark="qwen/qwen3-32b"
                                                      HorizontalAlignment="Stretch" />

                                             <TextBlock Text="Gemini API Key"
                                                        Foreground="#8BA3C7"
                                                        FontSize="12" />
                                             <TextBox Text="{Binding SpeakingPracticeGeminiApiKey}"
                                                      PasswordChar="*"
                                                      Watermark="AIza..."
                                                      HorizontalAlignment="Stretch" />

                                             <TextBlock Text="Gemini Model"
                                                        Foreground="#8BA3C7"
                                                        FontSize="12" />
                                             <TextBox Text="{Binding SpeakingPracticeGeminiModel}"
                                                      Watermark="gemini-2.5-flash"
                                                      HorizontalAlignment="Stretch" />
                                         </StackPanel>
                                     </suki:GlassCard>

                                      <TextBlock Text="{Binding TranslationStatus}"
                                                 Foreground="#8BA3C7"
                                                 FontSize="12"
                                                TextWrapping="Wrap" />

                                     <suki:GlassCard Background="#081221"
                                                     BorderBrush="#1E3A5F"
                                                     BorderThickness="1"
                                                     CornerRadius="8"
                                                     Padding="12">
                                         <StackPanel Spacing="8">
                                             <TextBlock Text="Realtime Runtime"
                                                        Foreground="#F0F4FF"
                                                        FontWeight="SemiBold" />
                                             <TextBlock Text="{Binding TranslationRuntimeStatus}"
                                                        Foreground="#93C5FD"
                                                        FontSize="12"
                                                        TextWrapping="Wrap" />
                                             <SelectableTextBlock Text="{Binding TranslationRuntimeDiagnostics}"
                                                                  Foreground="#8BA3C7"
                                                                  FontSize="12"
                                                                  TextWrapping="Wrap"
                                                                  IsVisible="{Binding HasTranslationRuntimeDiagnostics}" />
                                         </StackPanel>
                                     </suki:GlassCard>

                                     <suki:GlassCard Background="#081221"
                                                     BorderBrush="#1E3A5F"
                                                     BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    IsVisible="{Binding HasTranslationTestResult}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Result"
                                                       Foreground="#F0F4FF"
                                                       FontWeight="SemiBold" />
                                            <SelectableTextBlock Text="{Binding TranslationTestResult}"
                                                                 Foreground="#C7D7F2"
                                                                 TextWrapping="Wrap" />
                                        </StackPanel>
                                    </suki:GlassCard>

                                    <suki:GlassCard Background="#2A1111"
                                                    BorderBrush="#7F1D1D"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    IsVisible="{Binding HasTranslationTestError}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Error"
                                                       Foreground="#FECACA"
                                                       FontWeight="SemiBold" />
                                            <SelectableTextBlock Text="{Binding TranslationTestError}"
                                                                 Foreground="#FECACA"
                                                                 TextWrapping="Wrap" />
                                        </StackPanel>
                                    </suki:GlassCard>

                                    <suki:BusyArea IsBusy="{Binding IsTestingTranslation}"
                                                   BusyText="Testing translation...">
                                        <suki:GlassCard Background="#0D1F38"
                                                        CornerRadius="10"
                                                        Padding="14">
                                            <StackPanel Spacing="12">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Test Translation"
                                                               FontWeight="SemiBold"
                                                               Foreground="#F0F4FF" />
                                                    <TextBlock Text="Run a quick translation request using the current factory and provider settings."
                                                               Foreground="#8BA3C7"
                                                               FontSize="12"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>

                                                <TextBlock Text="Source Text"
                                                           Foreground="#8BA3C7"
                                                           FontSize="12" />
                                                <TextBox Text="{Binding TranslationTestSourceText}"
                                                         Watermark="Enter text to translate"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         MinHeight="80"
                                                         HorizontalAlignment="Stretch" />

                                                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="12">
                                                    <TextBlock Text="From"
                                                               VerticalAlignment="Center"
                                                               Foreground="#8BA3C7" />
                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding TranslationLanguages}"
                                                              SelectedValueBinding="{Binding Code}"
                                                              SelectedValue="{Binding TranslationTestSourceLanguage}"
                                                              DisplayMemberBinding="{Binding Name}"
                                                              HorizontalAlignment="Stretch" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="To"
                                                               VerticalAlignment="Center"
                                                               Foreground="#8BA3C7" />
                                                    <ComboBox Grid.Column="3"
                                                              ItemsSource="{Binding TranslationLanguages}"
                                                              SelectedValueBinding="{Binding Code}"
                                                              SelectedValue="{Binding TranslationTestTargetLanguage}"
                                                              DisplayMemberBinding="{Binding Name}"
                                                              HorizontalAlignment="Stretch" />
                                                </Grid>

                                                <Button Classes="action-button primary-action"
                                                        Command="{Binding TestTranslationCommand}"
                                                        Content="Run Translation Test"
                                                        HorizontalAlignment="Left"
                                                        MinWidth="180" />
                                            </StackPanel>
                                        </suki:GlassCard>
                                    </suki:BusyArea>
                                </StackPanel>
                    </suki:GlassCard>

                    <suki:GlassCard Classes="surface-card"
                                    Padding="20"
                                    IsVisible="{Binding IsOverlaySettingsTabActive}">
                        <StackPanel Spacing="16">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Show Overlay Window"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F0F4FF" />
                                            <TextBlock Classes="muted" FontSize="13"
                                                       Text="Toggle the transparent subtitle overlay on screen." />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Classes="action-button primary-action"
                                                Command="{Binding ToggleOverlayCommand}"
                                                Content="{Binding OverlayToggleLabel}"
                                                MinWidth="120"
                                                VerticalAlignment="Center" />
                                    </Grid>

                                    <suki:GlassCard Background="#0D1F38"
                                                    CornerRadius="10"
                                                    Padding="14">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Subtitle Font Size"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Foreground="#F0F4FF" />
                                                    <TextBlock Classes="muted" FontSize="13"
                                                               Text="Applies to the original subtitle text." />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding OverlayFontSize, StringFormat={}{0:0}px}"
                                                           FontSize="22"
                                                           FontWeight="Bold"
                                                           Foreground="#3B82F6"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBox Text="{Binding OverlayFontSize}"
                                                     Watermark="26"
                                                     HorizontalAlignment="Left"
                                                     Width="120" />
                                            <Slider Minimum="14"
                                                     Maximum="60"
                                                     Value="{Binding OverlayFontSize}"
                                                     TickFrequency="2"
                                                     IsSnapToTickEnabled="True" />
                                        </StackPanel>
                                    </suki:GlassCard>

                                    <suki:GlassCard Background="#0D1F38"
                                                    CornerRadius="10"
                                                    Padding="14">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Line Spacing"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Foreground="#F0F4FF" />
                                                    <TextBlock Classes="muted" FontSize="13"
                                                               Text="Controls spacing between overlay lines." />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding OverlayLineHeight, StringFormat={}{0:0.00}}"
                                                           FontSize="22"
                                                           FontWeight="Bold"
                                                           Foreground="#3B82F6"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <suki:GlassCard Background="#081221"
                                                            CornerRadius="10"
                                                            Padding="14">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Original line preview"
                                                               Foreground="#F0F4FF"
                                                               FontSize="16"
                                                               LineHeight="{Binding OverlayLineHeightPreviewPixels}" />
                                                    <TextBlock Text="Translated line preview"
                                                               Foreground="#8BA3C7"
                                                               FontSize="14"
                                                               LineHeight="{Binding OverlayLineHeightPreviewPixels}"
                                                               IsVisible="{Binding OverlayShowTranslation}" />
                                                    <TextBlock Text="Original line preview"
                                                               Foreground="#F0F4FF"
                                                               FontSize="16"
                                                               LineHeight="{Binding OverlayLineHeightPreviewPixels}" />
                                                    <TextBlock Text="Translated line preview"
                                                               Foreground="#8BA3C7"
                                                               FontSize="14"
                                                               LineHeight="{Binding OverlayLineHeightPreviewPixels}"
                                                               IsVisible="{Binding OverlayShowTranslation}" />
                                                </StackPanel>
                                            </suki:GlassCard>
                                            <suki:GlassCard Background="#081221"
                                                            CornerRadius="999"
                                                            Padding="4">
                                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                                    <Button Classes="action-button primary-action"
                                                            IsVisible="{Binding IsCompactOverlayLineHeightPreset}"
                                                            Command="{Binding SetOverlayLineHeightPresetCommand}"
                                                            CommandParameter="Compact"
                                                            Content="Compact" />
                                                    <Button Classes="action-button secondary-action"
                                                            IsVisible="{Binding IsDefaultOverlayLineHeightPreset}"
                                                            Command="{Binding SetOverlayLineHeightPresetCommand}"
                                                            CommandParameter="Compact"
                                                            Content="Compact" />
                                                    <Button Grid.Column="1"
                                                            Classes="action-button primary-action"
                                                            IsVisible="{Binding IsDefaultOverlayLineHeightPreset}"
                                                            Command="{Binding SetOverlayLineHeightPresetCommand}"
                                                            CommandParameter="Default"
                                                            Content="Default" />
                                                    <Button Grid.Column="1"
                                                            Classes="action-button secondary-action"
                                                            IsVisible="{Binding IsCompactOverlayLineHeightPreset}"
                                                            Command="{Binding SetOverlayLineHeightPresetCommand}"
                                                            CommandParameter="Default"
                                                            Content="Default" />
                                                    <Button Grid.Column="1"
                                                            Classes="action-button secondary-action"
                                                            IsVisible="{Binding IsRelaxedOverlayLineHeightPreset}"
                                                            Command="{Binding SetOverlayLineHeightPresetCommand}"
                                                            CommandParameter="Default"
                                                            Content="Default" />
                                                    <Button Grid.Column="2"
                                                            Classes="action-button primary-action"
                                                            IsVisible="{Binding IsRelaxedOverlayLineHeightPreset}"
                                                            Command="{Binding SetOverlayLineHeightPresetCommand}"
                                                            CommandParameter="Relaxed"
                                                            Content="Relaxed" />
                                                    <Button Grid.Column="2"
                                                            Classes="action-button secondary-action"
                                                            IsVisible="{Binding IsCompactOverlayLineHeightPreset}"
                                                            Command="{Binding SetOverlayLineHeightPresetCommand}"
                                                            CommandParameter="Relaxed"
                                                            Content="Relaxed" />
                                                    <Button Grid.Column="2"
                                                            Classes="action-button secondary-action"
                                                            IsVisible="{Binding IsDefaultOverlayLineHeightPreset}"
                                                            Command="{Binding SetOverlayLineHeightPresetCommand}"
                                                            CommandParameter="Relaxed"
                                                            Content="Relaxed" />
                                                </Grid>
                                            </suki:GlassCard>
                                            <TextBox Text="{Binding OverlayLineHeight}"
                                                     Watermark="1.35"
                                                     HorizontalAlignment="Left"
                                                     Width="120" />
                                            <Slider Minimum="0.90"
                                                    Maximum="2.20"
                                                    Value="{Binding OverlayLineHeight}"
                                                    TickFrequency="0.05" />
                                        </StackPanel>
                                    </suki:GlassCard>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Show Translation"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F0F4FF" />
                                            <TextBlock Classes="muted" FontSize="13"
                                                       Text="Show translated lines inside the overlay." />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding OverlayShowTranslation}"
                                                  VerticalAlignment="Center" />
                                    </Grid>

                                    <suki:GlassCard Background="#0D1F38"
                                                    CornerRadius="10"
                                                    Padding="14">
                                        <StackPanel Spacing="16">
                                            <TextBlock Text="Overlay Style"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F0F4FF" />
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                                <TextBlock Text="Theme"
                                                           VerticalAlignment="Center"
                                                           Foreground="#8BA3C7" />
                                                <ComboBox Grid.Column="1"
                                                          SelectedItem="{Binding OverlayTheme}">
                                                    <x:String>Dark</x:String>
                                                    <x:String>Light</x:String>
                                                </ComboBox>
                                            </Grid>
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="Opacity"
                                                               Foreground="#8BA3C7" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding OverlayOpacity, StringFormat={}{0:0.00}}"
                                                               Foreground="#3B82F6"
                                                               FontWeight="SemiBold" />
                                                </Grid>
                                                <Slider Minimum="0.35"
                                                        Maximum="1.00"
                                                        Value="{Binding OverlayOpacity}"
                                                        TickFrequency="0.05" />
                                            </StackPanel>
                                        </StackPanel>
                                    </suki:GlassCard>

                                    <TextBlock Classes="muted"
                                               Text="Resize overlay directly on screen. Drag to reposition. Use Light theme for dark videos and Dark theme for bright videos."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                    </suki:GlassCard>
                </StackPanel>
            </ScrollViewer>

    </Grid>
    </suki:BusyArea>

        <!-- Move selected sessions dialog -->
        <Border Grid.ColumnSpan="2"
                IsVisible="{Binding IsInstallSpeechModelsDialogOpen}"
                Background="#FF0B1220"
                ZIndex="100"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="720"
                  MaxWidth="720">
                <suki:GlassCard Padding="18"
                                Background="#FF111B2E"
                                Classes="surface-card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Install Speech Models"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Foreground="#F0F4FF" />
                        <TextBlock Text="Choose a preconfigured Vosk model package to download and install into the managed models folder."
                                   Foreground="#8BA3C7"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                        <suki:GlassCard Background="#0D1F38"
                                        CornerRadius="10"
                                        Padding="12"
                                        IsVisible="{Binding HasSpeechModelDownloadStatus}">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="12">
                                <suki:CircleProgressBar Width="26"
                                                        Height="26"
                                                        IsIndeterminate="True"
                                                        IsVisible="{Binding IsBusy}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SpeechModelDownloadStatus}"
                                           Foreground="#F0F4FF"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                                </Grid>
                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Value="{Binding SpeechModelDownloadPercent}"
                                             Height="8" />
                            </StackPanel>
                        </suki:GlassCard>
                        <suki:GlassCard Background="#301214"
                                        CornerRadius="10"
                                        Padding="12"
                                        IsVisible="{Binding HasSpeechModelDownloadError}">
                            <TextBlock Text="{Binding SpeechModelDownloadErrorMessage}"
                                       Foreground="#FCA5A5"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </suki:GlassCard>
                        <ItemsControl ItemsSource="{Binding InstallableSpeechModels}"
                                      IsVisible="{Binding HasInstallableSpeechModels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <suki:GlassCard Background="#081221"
                                                    CornerRadius="10"
                                                    Padding="14"
                                                    Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#F0F4FF" />
                                                <TextBlock Text="{Binding ModelName}"
                                                           Foreground="#8BA3C7"
                                                           FontSize="12" />
                                                <TextBlock Text="{Binding Language, StringFormat=Language: {0}}"
                                                           Foreground="#64748B"
                                                           FontSize="11" />
                                                <TextBlock Text="{Binding ErrorMessage}"
                                                           Foreground="#FCA5A5"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding HasError}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Classes="action-button primary-action"
                                                    Command="{Binding $parent[views:MainWindow].DataContext.InstallSpeechModelCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding InstallButtonLabel}"
                                                    IsEnabled="{Binding CanInstall}"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </suki:GlassCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No installable speech models are configured yet. Add entries to Config/speech-to-text-model-sources.json."
                                   Foreground="#8BA3C7"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding NoInstallableSpeechModels}" />
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="10">
                            <TextBlock Text="Installed models are disabled in this list."
                                       Foreground="#64748B"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Classes="action-button neutral-action"
                                    Command="{Binding CloseInstallSpeechModelsDialogCommand}"
                                    Content="Close" />
                        </Grid>
                    </StackPanel>
                </suki:GlassCard>
            </Grid>
        </Border>

        <Border Grid.ColumnSpan="2"
                IsVisible="{Binding IsMoveSessionsDialogOpen}"
                Background="#F0101828"
                ZIndex="100"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="520"
                  MaxWidth="520">
                <suki:GlassCard Padding="18"
                                Classes="surface-card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Move Selected Sessions"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Foreground="#F0F4FF" />
                        <TextBlock Text="Move selected capture records to another folder."
                                   Foreground="#8BA3C7"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                        <ComboBox ItemsSource="{Binding SessionFolders}"
                                  SelectedItem="{Binding MoveTargetSessionFolder}"
                                  DisplayMemberBinding="{Binding DisplayName}"
                                  PlaceholderText="Select target folder"
                                  HorizontalAlignment="Stretch" />
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="10">
                            <TextBlock Text="This updates session metadata and moves the folder on disk."
                                       Foreground="#64748B"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Classes="action-button neutral-action"
                                    Command="{Binding CloseMoveSessionsDialogCommand}"
                                    Content="Cancel" />
                            <Button Grid.Column="2"
                                    Classes="action-button primary-action"
                                    Command="{Binding MoveSelectedSessionsCommand}"
                                    Content="Move" />
                        </Grid>
                    </StackPanel>
                </suki:GlassCard>
            </Grid>
        </Border>

        <!-- Rename folder dialog -->
        <Border Grid.ColumnSpan="2"
                IsVisible="{Binding IsRenameSessionFolderDialogOpen}"
                Background="#F0101828"
                ZIndex="100"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="520"
                  MaxWidth="520">
                <suki:GlassCard Padding="18"
                                Classes="surface-card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Rename Folder"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Foreground="#F0F4FF" />
                        <TextBox Text="{Binding RenameSessionFolderName}"
                                 Watermark="Folder name"
                                 HorizontalAlignment="Stretch" />
                        <TextBlock Text="{Binding RenameSessionFolderValidationError}"
                                   Foreground="#FCA5A5"
                                   FontSize="11"
                                   IsVisible="{Binding HasRenameSessionFolderValidationError}" />
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="10">
                            <TextBlock Text="Global cannot be renamed."
                                       Foreground="#64748B"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Classes="action-button neutral-action"
                                    Command="{Binding CloseRenameSessionFolderDialogCommand}"
                                    Content="Cancel" />
                            <Button Grid.Column="2"
                                    Classes="action-button primary-action"
                                    Command="{Binding RenameSessionFolderCommand}"
                                    Content="Rename"
                                    IsEnabled="{Binding CanRenameSessionFolder}" />
                        </Grid>
                    </StackPanel>
                </suki:GlassCard>
            </Grid>
        </Border>

        <!-- Delete folder confirm dialog -->
        <Border Grid.ColumnSpan="2"
                IsVisible="{Binding IsDeleteSessionFolderDialogOpen}"
                Background="#F0101828"
                ZIndex="100"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="520"
                  MaxWidth="520">
                <suki:GlassCard Padding="18"
                                Classes="surface-card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Delete Folder"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Foreground="#F0F4FF" />
                        <TextBlock Text="Sessions inside this folder will be moved to Global before deletion."
                                   Foreground="#8BA3C7"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="10">
                            <TextBlock Text="This cannot be undone."
                                       Foreground="#64748B"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Classes="action-button neutral-action"
                                    Command="{Binding CloseDeleteSessionFolderDialogCommand}"
                                    Content="Cancel" />
                            <Button Grid.Column="2"
                                    Classes="action-button primary-action"
                                    Command="{Binding DeleteSessionFolderCommand}"
                                    Content="Delete" />
                        </Grid>
                    </StackPanel>
                </suki:GlassCard>
            </Grid>
        </Border>

        <Border Grid.ColumnSpan="2"
                IsVisible="{Binding IsCreateSessionDialogOpen}"
                Background="#F0101828"
                ZIndex="100"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="520"
                  MaxWidth="520">
                <suki:GlassCard Padding="18"
                                Classes="surface-card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Create Session Folder"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Foreground="#F0F4FF" />
                        <TextBlock Text="Create a flat folder (no nesting). Example: Work"
                                   Foreground="#8BA3C7"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                        <TextBox Text="{Binding NewSessionFolderName}"
                                 Watermark="Work"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock Text="{Binding NewSessionFolderValidationError}"
                                   Foreground="#FCA5A5"
                                   FontSize="11"
                                   IsVisible="{Binding HasNewSessionFolderValidationError}" />
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="10">
                            <TextBlock Text="Folder name will be sanitized for filesystem safety."
                                       Foreground="#64748B"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Classes="action-button neutral-action"
                                    Command="{Binding CloseCreateSessionDialogCommand}"
                                    Content="Cancel" />
                            <Button Grid.Column="2"
                                    Classes="action-button primary-action"
                                    Command="{Binding CreateSessionFolderCommand}"
                                    Content="Create"
                                    IsEnabled="{Binding CanCreateSessionFolder}" />
                        </Grid>
                    </StackPanel>
                </suki:GlassCard>
            </Grid>
        </Border>

    </Grid>
</suki:SukiWindow>
