<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sublingual.App.ViewModels.SpeakingPractice"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="980"
             d:DesignHeight="720"
             x:Class="Sublingual.App.Views.SpeakingPractice.PracticeSessionView"
             x:DataType="vm:PracticeSessionViewModel">

    <UserControl.Styles>
        <Style Selector="Button.practice-icon-button">
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.practice-icon-button:pointerover">
            <Setter Property="Opacity" Value="0.92" />
        </Style>
        <Style Selector="Button.practice-icon-button:pressed">
            <Setter Property="Opacity" Value="0.78" />
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <vm:PracticeSessionViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto" Margin="16">

        <Grid IsVisible="{Binding IsListPageActive}">
            <StackPanel Spacing="14">
                <suki:GlassCard Padding="20,16">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="AI Practice Rooms"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Opacity="0.94" />
                            <TextBlock Text="Create a room with instructions, then open it to chat or speak with AI."
                                       FontSize="13"
                                       Opacity="0.62"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="Accent practice-icon-button"
                                Command="{Binding OpenCreateRoomDialogCommand}"
                                IsEnabled="{Binding !IsRoomActionBusy}"
                                VerticalAlignment="Center">
                            <ToolTip.Tip>New Room</ToolTip.Tip>
                            <i:Icon Value="fa-solid fa-plus" FontSize="14" />
                        </Button>
                        <Button Grid.Column="2"
                                Classes="practice-icon-button"
                                Command="{Binding DeleteSelectedRoomsCommand}"
                                IsEnabled="{Binding HasSelectedRooms}"
                                VerticalAlignment="Center">
                            <ToolTip.Tip>Delete Selected</ToolTip.Tip>
                            <i:Icon Value="fa-solid fa-trash" FontSize="14" />
                        </Button>
                    </Grid>
                </suki:GlassCard>

                <TextBox Text="{Binding RoomSearchText}"
                         Watermark="Search rooms by title or instructions" />

                <suki:GlassCard Padding="16" IsVisible="{Binding !HasAnyRooms}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="No practice rooms yet."
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Create one with custom instructions such as a topic, vocabulary list, or advice style. Leave it empty to get a warm daily conversation room."
                                   FontSize="13"
                                   Opacity="0.68"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </suki:GlassCard>

                <suki:GlassCard Padding="16" IsVisible="{Binding NoSearchResults}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="No rooms match your search."
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Try a different keyword from the room title or instructions."
                                   FontSize="13"
                                   Opacity="0.68"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </suki:GlassCard>

                <ItemsControl ItemsSource="{Binding Rooms}" IsVisible="{Binding HasRooms}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SpeakingPracticeRoomItemViewModel">
                            <suki:GlassCard Margin="0,0,0,12" Padding="16,14">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Top"
                                              Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding InstructionsPreview}"
                                                   FontSize="12.5"
                                                   Opacity="0.68"
                                                   MaxLines="2"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding LastMessagePreview}"
                                                   FontSize="12"
                                                   Opacity="0.58"
                                                   MaxLines="1"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding HasLastMessagePreview}" />
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding CreatedAtText, StringFormat=Created {0}}"
                                                       FontSize="11"
                                                       Opacity="0.5" />
                                            <TextBlock Text="{Binding UpdatedAtText, StringFormat=Updated {0}}"
                                                       FontSize="11"
                                                       Opacity="0.5" />
                                            <TextBlock Text="{Binding MessageCount, StringFormat={}{0} message(s)}"
                                                       FontSize="11"
                                                       Opacity="0.5" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Command="{Binding $parent[UserControl].DataContext.OpenRoomCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="Accent practice-icon-button"
                                            IsEnabled="{Binding !$parent[UserControl].DataContext.IsRoomActionBusy}"
                                            VerticalAlignment="Center">
                                        <ToolTip.Tip>Open</ToolTip.Tip>
                                        <i:Icon Value="fa-solid fa-door-open" FontSize="13" />
                                    </Button>
                                     <Button Grid.Column="3"
                                             Command="{Binding $parent[UserControl].DataContext.OpenDeleteRoomDialogCommand}"
                                             CommandParameter="{Binding}"
                                             Classes="practice-icon-button"
                                             IsEnabled="{Binding !$parent[UserControl].DataContext.IsRoomActionBusy}"
                                             VerticalAlignment="Center">
                                         <ToolTip.Tip>Delete</ToolTip.Tip>
                                         <i:Icon Value="fa-solid fa-trash" FontSize="13" />
                                     </Button>
                                 </Grid>
                             </suki:GlassCard>
                         </DataTemplate>
                     </ItemsControl.ItemTemplate>
                 </ItemsControl>
            </StackPanel>
        </Grid>

        <Grid IsVisible="{Binding IsDetailPageActive}">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                <suki:GlassCard Grid.Row="0" Padding="14,10">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
                        <Button Classes="practice-icon-button"
                                Command="{Binding BackToRoomListCommand}"
                                VerticalAlignment="Center">
                            <ToolTip.Tip>Back to rooms</ToolTip.Tip>
                            <i:Icon Value="fa-solid fa-arrow-left" FontSize="14" />
                        </Button>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding RoomTitle}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ActiveAiRuntimeLabel, StringFormat=AI: {0}}"
                                       FontSize="11"
                                       Opacity="0.58" />
                            <TextBlock Text="Configured"
                                       FontSize="10.5"
                                       Foreground="#86EFAC"
                                       IsVisible="{Binding IsAiConfigured}" />
                            <TextBlock Text="Not configured"
                                       FontSize="10.5"
                                       Foreground="#FCA5A5"
                                       IsVisible="{Binding !IsAiConfigured}" />
                            <TextBlock Text="{Binding RoomInstructions}"
                                       FontSize="11.5"
                                       Opacity="0.66"
                                       TextWrapping="Wrap"
                                       MaxLines="3" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="practice-icon-button"
                                Command="{Binding OpenEditRoomDialogCommand}"
                                IsEnabled="{Binding !IsRoomActionBusy}"
                                VerticalAlignment="Center">
                            <ToolTip.Tip>Edit room</ToolTip.Tip>
                            <i:Icon Value="fa-solid fa-pen" FontSize="14" />
                        </Button>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding StatusText}"
                                   FontSize="12"
                                   Opacity="0.58"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right" />
                    </Grid>
                </suki:GlassCard>

                <suki:GlassCard Grid.Row="1" Padding="14,10"
                                IsVisible="{Binding HasRecordingTranscriptPreview}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Recording Preview"
                                   FontSize="11"
                                   Opacity="0.54" />
                        <TextBlock Text="{Binding RecordingTranscriptPreview}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="13.5" />
                    </StackPanel>
                </suki:GlassCard>

                <suki:GlassCard Grid.Row="2" Padding="6">
                    <ScrollViewer x:Name="MessagesScrollViewer"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6">
                            <ItemsControl ItemsSource="{Binding Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PracticeMessageViewModel">
                                        <Grid Margin="8,6">
                                            <StackPanel IsVisible="{Binding IsUser}"
                                                        HorizontalAlignment="Right"
                                                        MaxWidth="620"
                                                        Spacing="4">
                                                <suki:GlassCard Padding="14,10" Tag="{Binding}">
                                                    <suki:GlassCard.ContextMenu>
                                                        <ContextMenu Placement="Bottom">
                                                            <MenuItem Header="Suggestions"
                                                                      Click="OnMessageSuggestionsMenuItemClick"
                                                                      IsVisible="{Binding !IsUser}" />
                                                            <MenuItem Header="Play" Click="OnMessagePlayMenuItemClick" />
                                                            <MenuItem Header="Stop"
                                                                      Click="OnMessageStopMenuItemClick"
                                                                      IsVisible="{Binding !IsUser}" />
                                                        </ContextMenu>
                                                    </suki:GlassCard.ContextMenu>
                                                    <suki:GlassCard.Styles>
                                                        <Style Selector="suki|GlassCard">
                                                            <Setter Property="Background" Value="#1A3A6B" />
                                                        </Style>
                                                    </suki:GlassCard.Styles>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Text}"
                                                                   IsVisible="{Binding !IsSpoken}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="14" />
                                                        <TextBlock Text="{Binding SingleLineText}"
                                                                   IsVisible="{Binding IsSpoken}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontSize="14" />
                                                    </Grid>
                                                </suki:GlassCard>

                                                <!-- (Removed) correction/scoring UI -->
                                            </StackPanel>

                                            <StackPanel IsVisible="{Binding !IsUser}"
                                                        HorizontalAlignment="Left"
                                                        MaxWidth="620"
                                                        Spacing="4">
                                                <suki:GlassCard Padding="14,10" Tag="{Binding}">
                                                    <suki:GlassCard.ContextMenu>
                                                        <ContextMenu Placement="Bottom">
                                                            <MenuItem Header="Suggestions"
                                                                      Click="OnMessageSuggestionsMenuItemClick"
                                                                      IsVisible="{Binding !IsUser}" />
                                                            <MenuItem Header="Play" Click="OnMessagePlayMenuItemClick" />
                                                            <MenuItem Header="Stop"
                                                                      Click="OnMessageStopMenuItemClick"
                                                                      IsVisible="{Binding !IsUser}" />
                                                        </ContextMenu>
                                                    </suki:GlassCard.ContextMenu>
                                                    <suki:GlassCard.Styles>
                                                        <Style Selector="suki|GlassCard">
                                                            <Setter Property="Background" Value="#0E2E22" />
                                                        </Style>
                                                    </suki:GlassCard.Styles>
                                                    <TextBlock Text="{Binding Text}"
                                                               TextWrapping="Wrap"
                                                               FontSize="14" />
                                                </suki:GlassCard>

                                                <!-- Suggestions display -->
                                                <suki:GlassCard IsVisible="{Binding ShowSuggestions}"
                                                                Padding="12,8">
                                                    <suki:GlassCard.Styles>
                                                        <Style Selector="suki|GlassCard">
                                                            <Setter Property="Background" Value="#1E293B" />
                                                        </Style>
                                                    </suki:GlassCard.Styles>
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="Suggestions" FontSize="10.5" Opacity="0.6" FontWeight="SemiBold" />
                                                        <ItemsControl ItemsSource="{Binding Suggestions}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Margin="0,0,6,6"
                                                                            Command="{Binding $parent[UserControl].DataContext.ChooseSuggestionCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            IsEnabled="{Binding $parent[UserControl].DataContext.CanChooseSuggestion}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                            <TextBlock Text="{Binding Label}"
                                                                                       FontSize="10"
                                                                                       Opacity="0.6" />
                                                                            <TextBlock Text="{Binding Text}"
                                                                                       FontSize="12" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </suki:GlassCard>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Inline "thinking" bubble (non-blocking) -->
                            <StackPanel IsVisible="{Binding IsThinking}"
                                        HorizontalAlignment="Left"
                                        MaxWidth="620"
                                        Margin="8,6"
                                        Spacing="4">
                                <suki:GlassCard Padding="14,10">
                                    <suki:GlassCard.Styles>
                                        <Style Selector="suki|GlassCard">
                                            <Setter Property="Background" Value="#0E2E22" />
                                        </Style>
                                    </suki:GlassCard.Styles>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <suki:Loading Width="14" Height="14" />
                                        <TextBlock Text="Tutor is thinking..."
                                                   TextWrapping="NoWrap"
                                                   Opacity="0.82"
                                                   FontSize="14" />
                                    </StackPanel>
                                </suki:GlassCard>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </suki:GlassCard>
                <suki:GlassCard Grid.Row="3" Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <TextBox x:Name="TypedMessageTextBox"
                                 Text="{Binding TypedMessage, UpdateSourceTrigger=PropertyChanged}"
                                   Watermark="Type a message to the tutor"
                                   AcceptsReturn="True"
                                   HorizontalAlignment="Stretch"
                                   VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Classes="practice-icon-button Accent"
                                Command="{Binding SendTypedMessageCommand}"
                                IsEnabled="{Binding CanSendTypedMessage}">
                            <ToolTip.Tip>
                                <StackPanel>
                                    <TextBlock Text="{Binding AiActionHint}" IsVisible="{Binding !IsAiConfigured}" />
                                    <TextBlock Text="Send message" IsVisible="{Binding IsAiConfigured}" />
                                </StackPanel>
                            </ToolTip.Tip>
                            <i:Icon Value="fa-solid fa-paper-plane" FontSize="13" />
                        </Button>
                        <Button Grid.Column="2" Classes="practice-icon-button"
                                Command="{Binding StartSpeakingCommand}"
                                IsVisible="{Binding !IsRecording}"
                                IsEnabled="{Binding CanStartSpeaking}">
                            <ToolTip.Tip>
                                <StackPanel>
                                    <TextBlock Text="{Binding AiActionHint}" IsVisible="{Binding !IsAiConfigured}" />
                                    <TextBlock Text="Start speaking" IsVisible="{Binding IsAiConfigured}" />
                                </StackPanel>
                            </ToolTip.Tip>
                            <i:Icon Value="fa-solid fa-microphone" FontSize="14" />
                        </Button>
                        <Button Grid.Column="2" Classes="practice-icon-button Accent"
                                Command="{Binding StopSpeakingCommand}"
                                IsVisible="{Binding IsRecording}"
                                IsEnabled="{Binding CanStopSpeaking}">
                            <ToolTip.Tip>Stop speaking</ToolTip.Tip>
                            <i:Icon Value="fa-solid fa-stop" FontSize="14" />
                        </Button>
                    </Grid>
                </suki:GlassCard>
            </Grid>
        </Grid>

        <suki:GlassCard Grid.Row="1" Padding="14,8" Margin="0,12,0,0" IsVisible="{Binding HasStatusText}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12.5"
                           Opacity="0.72"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Command="{Binding OpenSpeakingSettingsCommand}"
                        Content="Open Settings"
                        IsVisible="{Binding ShowOpenSettingsForAi}"
                        Classes="practice-icon-button"
                        VerticalAlignment="Center" />
            </Grid>
        </suki:GlassCard>

        <Border Grid.RowSpan="2"
                IsVisible="{Binding IsCreateRoomDialogOpen}"
                Background="#F0101828"
                ZIndex="100"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,24">
                <Grid HorizontalAlignment="Center"
                      Width="620"
                      MaxWidth="620">
                    <suki:GlassCard Padding="18" Classes="surface-card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Create Practice Room"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       Foreground="#F0F4FF" />
                            <TextBlock Text="Enter instructions for this room. Example: practice ordering coffee, use these vocabulary words, or act like a caring family member giving advice. Leave it blank for a warm daily conversation room."
                                       Foreground="#8BA3C7"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBox Text="{Binding NewRoomTitle}"
                                     Watermark="Optional room title, e.g. Job Interview Practice"
                                     HorizontalAlignment="Stretch" />
                            <TextBox Text="{Binding NewRoomInstructions}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="140"
                                     VerticalContentAlignment="Top"
                                     Watermark="Example: Talk only about preparing for a frontend interview and encourage the user to answer in simple English." />

                            <Button Content="Instruction Builder"
                                    Classes="action-button neutral-action"
                                    Command="{Binding ToggleCreateInstructionBuilderCommand}"
                                    HorizontalAlignment="Left" />

                            <Border IsVisible="{Binding IsCreateInstructionBuilderOpen}"
                                    Background="#0CFFFFFF"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Build simple room instructions without writing a prompt." Foreground="#64748B" FontSize="11" TextWrapping="Wrap" />

                                    <Grid ColumnDefinitions="Auto,* ,Auto" ColumnSpacing="10">
                                        <TextBlock Text="Quick template" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  SelectedItem="{Binding SelectedQuickInstructionTemplate}"
                                                  ItemsSource="{Binding QuickInstructionTemplates}"
                                                  DisplayMemberBinding="{Binding Name}" />
                                        <Button Grid.Column="2"
                                                Content="Use"
                                                Classes="action-button neutral-action"
                                                Command="{Binding ApplyQuickTemplateCommand}"
                                                CommandParameter="new" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                        <Button Content="Load from instructions"
                                                Classes="action-button neutral-action"
                                                Command="{Binding LoadInstructionBuilderFromInstructionsCommand}"
                                                CommandParameter="new" />
                                        <Button Grid.Column="1"
                                                Content="Clear"
                                                Classes="action-button neutral-action"
                                                Command="{Binding ClearInstructionBuilderCommand}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <TextBlock Text="Mode" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  SelectedItem="{Binding InstructionBuilderMode}"
                                                  ItemsSource="{Binding InstructionBuilderModes}" />
                                    </Grid>

                                    <TextBox Text="{Binding BuilderTopic}"
                                             Watermark="Topic (Daily), e.g. hobbies, work, travel"
                                             HorizontalAlignment="Stretch" />

                                    <TextBox Text="{Binding BuilderScenario}"
                                             Watermark="Scenario (Roleplay), e.g. ordering coffee"
                                             HorizontalAlignment="Stretch" />

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <TextBox Text="{Binding BuilderTutorRole}"
                                                 Watermark="Tutor role (Roleplay), e.g. barista"
                                                 HorizontalAlignment="Stretch" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding BuilderUserRole}"
                                                 Watermark="User role (Roleplay), e.g. customer"
                                                 HorizontalAlignment="Stretch" />
                                    </Grid>

                                    <TextBox Text="{Binding BuilderGoal}"
                                             Watermark="Goal, e.g. practice polite requests"
                                             HorizontalAlignment="Stretch" />
                                    <TextBox Text="{Binding BuilderConstraints}"
                                             Watermark="Constraints (optional), e.g. keep it short"
                                             HorizontalAlignment="Stretch" />
                                    <TextBox Text="{Binding BuilderTone}"
                                             Watermark="Tone (optional), e.g. friendly and casual"
                                             HorizontalAlignment="Stretch" />

                                    <Button Content="Insert Into Instructions"
                                            Classes="action-button neutral-action"
                                            Command="{Binding ApplyInstructionBuilderCommand}"
                                            CommandParameter="new"
                                            HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding NewRoomValidationError}"
                                       Foreground="#FCA5A5"
                                       FontSize="11"
                                       IsVisible="{Binding HasCreateRoomValidationError}" />
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <TextBlock Text="The AI will always follow these instructions for this room."
                                           Foreground="#64748B"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Classes="action-button neutral-action"
                                        Command="{Binding CloseCreateRoomDialogCommand}"
                                        Content="Cancel" />
                                <Button Grid.Column="2"
                                        Classes="action-button primary-action"
                                        Command="{Binding CreateRoomCommand}"
                                        Content="Create"
                                        IsEnabled="{Binding CanCreateRoom}" />
                            </Grid>
                        </StackPanel>
                    </suki:GlassCard>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.RowSpan="2"
                IsVisible="{Binding IsDeleteRoomsDialogOpen}"
                Background="#F0101828"
                ZIndex="100"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="520"
                  MaxWidth="520">
                <suki:GlassCard Padding="18" Classes="surface-card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Delete Practice Room"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Foreground="#F0F4FF" />
                        <TextBlock Text="{Binding DeleteRoomsDialogMessage}"
                                   Foreground="#8BA3C7"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <TextBlock Text="This action cannot be undone."
                                       Foreground="#64748B"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Classes="action-button neutral-action"
                                    Command="{Binding CloseDeleteRoomsDialogCommand}"
                                    Content="Cancel" />
                            <Button Grid.Column="2"
                                    Classes="action-button primary-action"
                                    Command="{Binding ConfirmDeleteRoomsCommand}"
                                    Content="Delete"
                                    IsEnabled="{Binding !IsRoomActionBusy}" />
                        </Grid>
                    </StackPanel>
                </suki:GlassCard>
            </Grid>
        </Border>

        <Border Grid.RowSpan="2"
                IsVisible="{Binding IsEditRoomDialogOpen}"
                Background="#F0101828"
                ZIndex="100"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,24">
                <Grid HorizontalAlignment="Center"
                      Width="620"
                      MaxWidth="620">
                    <suki:GlassCard Padding="18" Classes="surface-card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Edit Practice Room"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       Foreground="#F0F4FF" />
                            <TextBox Text="{Binding EditRoomTitle}"
                                     Watermark="Optional room title"
                                     HorizontalAlignment="Stretch" />
                            <TextBox Text="{Binding EditRoomInstructions}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="140"
                                     VerticalContentAlignment="Top"
                                     Watermark="Update the instructions for this room." />

                            <Button Content="Instruction Builder"
                                    Classes="action-button neutral-action"
                                    Command="{Binding ToggleEditInstructionBuilderCommand}"
                                    HorizontalAlignment="Left" />

                            <Border IsVisible="{Binding IsEditInstructionBuilderOpen}"
                                    Background="#0CFFFFFF"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Build simple room instructions without writing a prompt." Foreground="#64748B" FontSize="11" TextWrapping="Wrap" />

                                    <Grid ColumnDefinitions="Auto,* ,Auto" ColumnSpacing="10">
                                        <TextBlock Text="Quick template" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  SelectedItem="{Binding SelectedQuickInstructionTemplate}"
                                                  ItemsSource="{Binding QuickInstructionTemplates}"
                                                  DisplayMemberBinding="{Binding Name}" />
                                        <Button Grid.Column="2"
                                                Content="Use"
                                                Classes="action-button neutral-action"
                                                Command="{Binding ApplyQuickTemplateCommand}"
                                                CommandParameter="edit" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                        <Button Content="Load from instructions"
                                                Classes="action-button neutral-action"
                                                Command="{Binding LoadInstructionBuilderFromInstructionsCommand}"
                                                CommandParameter="edit" />
                                        <Button Grid.Column="1"
                                                Content="Clear"
                                                Classes="action-button neutral-action"
                                                Command="{Binding ClearInstructionBuilderCommand}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <TextBlock Text="Mode" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  SelectedItem="{Binding InstructionBuilderMode}"
                                                  ItemsSource="{Binding InstructionBuilderModes}" />
                                    </Grid>

                                    <TextBox Text="{Binding BuilderTopic}"
                                             Watermark="Topic (Daily), e.g. hobbies, work, travel"
                                             HorizontalAlignment="Stretch" />

                                    <TextBox Text="{Binding BuilderScenario}"
                                             Watermark="Scenario (Roleplay), e.g. ordering coffee"
                                             HorizontalAlignment="Stretch" />

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <TextBox Text="{Binding BuilderTutorRole}"
                                                 Watermark="Tutor role (Roleplay), e.g. barista"
                                                 HorizontalAlignment="Stretch" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding BuilderUserRole}"
                                                 Watermark="User role (Roleplay), e.g. customer"
                                                 HorizontalAlignment="Stretch" />
                                    </Grid>

                                    <TextBox Text="{Binding BuilderGoal}"
                                             Watermark="Goal, e.g. practice polite requests"
                                             HorizontalAlignment="Stretch" />
                                    <TextBox Text="{Binding BuilderConstraints}"
                                             Watermark="Constraints (optional), e.g. keep it short"
                                             HorizontalAlignment="Stretch" />
                                    <TextBox Text="{Binding BuilderTone}"
                                             Watermark="Tone (optional), e.g. friendly and casual"
                                             HorizontalAlignment="Stretch" />

                                    <Button Content="Insert Into Instructions"
                                            Classes="action-button neutral-action"
                                            Command="{Binding ApplyInstructionBuilderCommand}"
                                            CommandParameter="edit"
                                            HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding EditRoomValidationError}"
                                       Foreground="#FCA5A5"
                                       FontSize="11"
                                       IsVisible="{Binding HasEditRoomValidationError}" />
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <TextBlock Text="The updated instructions will guide future AI replies in this room."
                                           Foreground="#64748B"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Classes="action-button neutral-action"
                                        Command="{Binding CloseEditRoomDialogCommand}"
                                        Content="Cancel" />
                                <Button Grid.Column="2"
                                        Classes="action-button primary-action"
                                        Command="{Binding SaveRoomEditsCommand}"
                                        Content="Save"
                                        IsEnabled="{Binding CanSaveRoomEdits}" />
                            </Grid>
                        </StackPanel>
                    </suki:GlassCard>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
