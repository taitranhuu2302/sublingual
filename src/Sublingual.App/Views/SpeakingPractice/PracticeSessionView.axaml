<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sublingual.App.ViewModels.SpeakingPractice"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="860"
             d:DesignHeight="680"
             x:Class="Sublingual.App.Views.SpeakingPractice.PracticeSessionView"
             x:DataType="vm:PracticeSessionViewModel">

    <Design.DataContext>
        <vm:PracticeSessionViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">

        <!-- ─── Header ──────────────────────────────────────────────── -->
        <suki:GlassCard Grid.Row="0" Margin="0,0,0,12" Padding="20,14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="🎙 AI Speaking Practice"
                               FontSize="20" FontWeight="SemiBold"
                               Opacity="0.92"/>
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="13" Opacity="0.6"/>
                </StackPanel>

                <!-- Topic input + Start/Stop -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <TextBox Text="{Binding Topic}"
                             Watermark="Enter topic, e.g. Ordering Coffee"
                             Width="280" VerticalContentAlignment="Center"
                             IsEnabled="{Binding !IsSessionActive}"/>
                    <Button Content="Start"
                            Command="{Binding StartSessionCommand}"
                            IsEnabled="{Binding !IsSessionActive}"
                            Classes="Accent"/>
                    <Button Content="Stop"
                            Command="{Binding StopSessionCommand}"
                            IsEnabled="{Binding IsSessionActive}"/>
                </StackPanel>
            </Grid>
        </suki:GlassCard>

        <!-- ─── Chat Area wrapped in BusyArea ───────────────────────── -->
        <suki:BusyArea Grid.Row="1"
                       IsBusy="{Binding IsThinking}"
                       BusyText="Tutor is thinking..."
                       Margin="0,0,0,12">
            <suki:GlassCard Padding="4">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,6">
                                    <!-- USER bubble → right-aligned -->
                                    <StackPanel IsVisible="{Binding IsUser}"
                                                HorizontalAlignment="Right"
                                                MaxWidth="520" Spacing="4">

                                        <suki:GlassCard Padding="14,10">
                                            <suki:GlassCard.Styles>
                                                <Style Selector="suki|GlassCard">
                                                    <Setter Property="Background"
                                                            Value="#1A3A6B"/>
                                                </Style>
                                            </suki:GlassCard.Styles>
                                            <TextBlock Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       FontSize="14"/>
                                        </suki:GlassCard>

                                        <!-- Enhancement Tip (amber card, only when present) -->
                                        <suki:GlassCard IsVisible="{Binding HasEnhancement}"
                                                        Padding="12,8">
                                            <suki:GlassCard.Styles>
                                                <Style Selector="suki|GlassCard">
                                                    <Setter Property="Background"
                                                            Value="#2A1D00"/>
                                                </Style>
                                            </suki:GlassCard.Styles>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="💡" FontSize="14"
                                                           VerticalAlignment="Top"/>
                                                <TextBlock Text="{Binding EnhancementAdvice}"
                                                           FontSize="12.5"
                                                           TextWrapping="Wrap"
                                                           Opacity="0.88"/>
                                            </StackPanel>
                                        </suki:GlassCard>
                                    </StackPanel>

                                    <!-- AI bubble → left-aligned -->
                                    <suki:GlassCard IsVisible="{Binding !IsUser}"
                                                    HorizontalAlignment="Left"
                                                    MaxWidth="520"
                                                    Padding="14,10">
                                        <suki:GlassCard.Styles>
                                            <Style Selector="suki|GlassCard">
                                                <Setter Property="Background"
                                                        Value="#0E2E22"/>
                                            </Style>
                                        </suki:GlassCard.Styles>
                                        <TextBlock Text="{Binding Text}"
                                                   TextWrapping="Wrap"
                                                   FontSize="14"/>
                                    </suki:GlassCard>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </suki:GlassCard>
        </suki:BusyArea>

        <!-- ─── Suggestion Chips ─────────────────────────────────────── -->
        <suki:GlassCard Grid.Row="2" Padding="16,10" Margin="0,0,0,10"
                        IsVisible="{Binding IsSessionActive}">
            <StackPanel Spacing="6">
                <TextBlock Text="💬 Stuck? Try saying:"
                           FontSize="12" Opacity="0.55" Margin="0,0,0,4"/>
                <WrapPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding Suggestions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,8,8"
                                        Command="{Binding $parent[UserControl].DataContext.ChooseSuggestionCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="11" Opacity="0.6"/>
                                        <TextBlock Text="{Binding Text}"
                                                   FontSize="13"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </StackPanel>
        </suki:GlassCard>

        <!-- ─── Status Footer ─────────────────────────────────────────── -->
        <suki:GlassCard Grid.Row="3" Padding="14,8">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <suki:Loading IsVisible="{Binding IsThinking}"
                                  Width="18" Height="18"/>
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12.5" Opacity="0.7"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="🔊 AI Speaking"
                           IsVisible="{Binding IsSpeaking}"
                           FontSize="12" Opacity="0.6"
                           VerticalAlignment="Center"/>
            </Grid>
        </suki:GlassCard>

    </Grid>
</UserControl>
