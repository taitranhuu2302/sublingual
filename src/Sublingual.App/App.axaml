<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:sukiEnums="clr-namespace:SukiUI.Enums;assembly=SukiUI"
             xmlns:avalonia="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             x:Class="Sublingual.App.App"
             xmlns:local="using:Sublingual.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <suki:SukiTheme ThemeColor="{x:Static sukiEnums:SukiColor.Blue}" />
        <StyleInclude Source="/Styles/DebugCaptureStyles.axaml" />
    </Application.Styles>

    <avalonia:TrayIcon.Icons>
        <avalonia:TrayIcons>
            <avalonia:TrayIcon Icon="/Assets/logo.ico"
                               ToolTipText="Sublingual"
                               IsVisible="True">
                <avalonia:TrayIcon.Menu>
                    <avalonia:NativeMenu>
                        <avalonia:NativeMenuItem Header="Open" />
                        <avalonia:NativeMenuItemSeparator />
                        <avalonia:NativeMenuItem Header="Exit" />
                    </avalonia:NativeMenu>
                </avalonia:TrayIcon.Menu>
            </avalonia:TrayIcon>
        </avalonia:TrayIcons>
    </avalonia:TrayIcon.Icons>
</Application>
